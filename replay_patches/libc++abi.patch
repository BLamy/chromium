diff --git a/src/cxa_guard_impl.h b/src/cxa_guard_impl.h
index 5f51e81..edcff82 100644
--- a/src/cxa_guard_impl.h
+++ b/src/cxa_guard_impl.h
@@ -64,6 +64,11 @@
 #include <limits.h>
 #include <stdlib.h>
 
+#if defined(__APPLE__)
+#  include <dlfcn.h>
+#  include <pthread.h>
+#endif
+
 #ifndef _LIBCXXABI_HAS_NO_THREADS
 #  if defined(__ELF__) && defined(_LIBCXXABI_LINK_PTHREAD_LIB)
 #    pragma comment(lib, "pthread")
@@ -286,12 +291,31 @@ struct LibcppMutex {
   LibcppMutex(LibcppMutex const&) = delete;
   LibcppMutex& operator=(LibcppMutex const&) = delete;
 
-  bool lock() { return std::__libcpp_mutex_lock(&mutex); }
+  bool lock() {
+#if defined(__APPLE__)
+    // [RecordReplay] This one mutex decides which thread runs a function's
+    // static initializer when two get there together. Replay's driver orders
+    // a mutex it has been told about, so that the same thread wins when a
+    // recording replays, and what the initializer does is found on the thread
+    // the recording has it on. The first lock is long before a second thread.
+    if (!record_replay_registered) {
+      record_replay_registered = true;
+      void* fn = dlsym(RTLD_DEFAULT, "RecordReplayAddOrderedPthreadMutex");
+      if (fn) {
+        reinterpret_cast<void (*)(const char*, pthread_mutex_t*)>(fn)("__cxa_guard", &mutex);
+      }
+    }
+#endif
+    return std::__libcpp_mutex_lock(&mutex);
+  }
   bool unlock() { return std::__libcpp_mutex_unlock(&mutex); }
 
 private:
   friend struct LibcppCondVar;
   std::__libcpp_mutex_t mutex = _LIBCPP_MUTEX_INITIALIZER;
+#if defined(__APPLE__)
+  bool record_replay_registered = false;
+#endif
 };
 
 struct LibcppCondVar {
